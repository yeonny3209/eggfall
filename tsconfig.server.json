{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ],
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "server",
    "src/net/protocol.ts",
    "src/net/schema.ts",
    "src/net/prediction.ts",
    "src/flight/simulate.ts",
    "src/egg/spawn.ts",
    "src/player/progress.ts",
    "src/world/terrain.ts",
    "src/types.ts"
  ]
}